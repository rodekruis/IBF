{
  "servers": {
    "ado": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "redcrossnl",
        "--authentication",
        "azcli"
      ],
      "env": {
        "ado_mcp_project": "National Risk Watch"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
